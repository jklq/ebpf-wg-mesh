{
  "name": "managed-console",
  "private": true,
  "packageManager": "bun@1.3.11",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run generate:proto && vite dev --host 127.0.0.1 --port 3000 --strictPort",
    "generate:proto": "bunx buf generate",
    "build": "bun run generate:proto && NITRO_PRESET=bun vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "start": "bun run .output/server/index.mjs",
    "test": "bun run test:unit",
    "test:unit": "bun run generate:proto && bunx vitest run --config vitest.unit.config.ts",
    "test:integration": "bun run test:db-integration",
    "test:db-integration": "bunx vitest run --config vitest.integration.config.ts",
    "test:e2e:local": "bunx playwright test -c playwright.local.config.ts",
    "format": "bunx biome format",
    "lint": "bunx biome lint",
    "check": "bun run generate:proto && bunx biome check && bun run check:architecture",
    "check:architecture": "bun run tooling/check-architecture.ts",
    "typecheck": "bun run generate:proto && bunx tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/router-plugin": "^1.168.48",
    "lucide-react": "^0.545.0",
    "pg": "^8.23.1",
    "pg-connection-string": "2.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@playwright/test": "^1.64.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^28.1.0",
    "nitro": "^3.0.260610-beta",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
