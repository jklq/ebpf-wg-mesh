{
  "name": "managed-console",
  "private": true,
  "packageManager": "bun@1.3.11",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --host 127.0.0.1 --port 3000 --strictPort",
    "build": "NITRO_PRESET=bun bun --bun vite build",
    "preview": "bun --bun vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "start": "bun run .output/server/index.mjs",
    "test": "bun run test:unit",
    "test:unit": "bunx vitest run --config vitest.unit.config.ts",
    "test:integration": "bun run test:e2e:local",
    "test:e2e:local": "bunx playwright test -c playwright.local.config.ts",
    "format": "bunx biome format",
    "lint": "bunx biome lint",
    "check": "bunx biome check"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "effect": "^4.0.0-beta.35",
    "google-proto-files": "^5.0.1",
    "lucide-react": "^0.545.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.1.0",
    "nitro": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  }
}
