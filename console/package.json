{
  "name": "managed-console",
  "private": true,
  "packageManager": "bun@1.3.11",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run generate:proto && bun --bun vite dev --host 127.0.0.1 --port 3000 --strictPort",
    "generate:proto": "bunx buf generate",
    "build": "bun run generate:proto && NITRO_PRESET=bun bun --bun vite build",
    "preview": "bun --bun vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "start": "bun run .output/server/index.mjs",
    "test": "bun run test:unit",
    "test:unit": "bun run generate:proto && bunx vitest run --config vitest.unit.config.ts",
    "test:integration": "bun run test:db-integration",
    "test:db-integration": "bunx vitest run --config vitest.integration.config.ts",
    "test:e2e:local": "bunx playwright test -c playwright.local.config.ts",
    "format": "bunx biome format",
    "lint": "bunx biome lint",
    "check": "bun run generate:proto && bunx biome check",
    "typecheck": "bun run generate:proto && bunx tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "^1.166.17",
    "@tanstack/router-plugin": "^1.132.0",
    "lucide-react": "^0.545.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.14.1",
    "@playwright/test": "^1.55.0",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.1.0",
    "nitro": "^3.0.260610-beta",
    "typescript": "^5.7.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "zod": "^4.5.4"
  }
}
