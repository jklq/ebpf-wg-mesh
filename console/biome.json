{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"**/vitest*.config.ts",
			"**/tooling/**/*.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/lib/platform-gen"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"overrides": [
		{
			"includes": ["**/src/styles/reset.css"],
			"linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
