[Unit]
Description=Verify and publish complete platform recovery points
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=platform-recovery
UMask=0077
Environment=PLATFORM_RECOVERY_CONFIG=/etc/platform/recovery.json
ExecStart=/opt/platform/platformctl recovery complete --source-config /etc/platform/source-backend.json
TimeoutStartSec=15min
